# Domain that points at this VPS (A/AAAA record). Caddy gets the certificate for it.
DOMAIN=gate.example.com
# Same domain as a URL. The Mini App and webhook are served from here.
BASE_URL=https://gate.example.com

# From @BotFather
BOT_TOKEN=123456789:replace-me
# Any long random string: openssl rand -hex 32
WEBHOOK_SECRET=replace-me

# How long a minimised or abandoned captcha waits before the request is declined.
# 300 is the design value; 60 makes testing quicker.
GRACE_SECONDS=300

# webhook (default, behind Caddy) or polling (for local development)
MODE=webhook
