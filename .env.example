# Public HTTPS address of the bot, the domain you set up in Nginx Proxy Manager.
# The Mini App and the Telegram webhook are served from here.
BASE_URL=https://gate.example.com

# From @BotFather
BOT_TOKEN=123456789:replace-me
# Any long random string: openssl rand -hex 32
WEBHOOK_SECRET=replace-me

# How long a minimised or abandoned captcha waits before the request is declined.
# 300 is the design value; 60 makes testing quicker.
GRACE_SECONDS=300

# webhook (default, behind a reverse proxy) or polling (for local development)
MODE=webhook

# Docker network Nginx Proxy Manager is on (docker network ls). Used by docker-compose.yml.
NPM_NETWORK=npm_default

# Only for docker-compose.caddy.yml (no other reverse proxy): the bare domain.
# DOMAIN=gate.example.com
